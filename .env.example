# Copie para .env (cp .env.example .env) e preencha.

# --- AWS (DynamoDB continua na nuvem) ---
# No AWS Academy: "AWS Details" > "AWS CLI" mostra os três valores (expiram a cada sessão do lab).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
DYNAMO_TABLE=dspn-projeto-dynamo-logs

# --- Aplicação ---
ADMIN_TOKEN=troque-esta-senha
FRONTEND_PORT=8080

# --- Serviços em containers ---
POSTGRES_USER=cinematix
POSTGRES_PASSWORD=cinematix
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_BUCKET=cinematix
RABBITMQ_USER=cinematix
